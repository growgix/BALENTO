# =============================================================================
# BALENTO E-Commerce Backend Environment Configuration
# =============================================================================

# Application Settings
APP_NAME="BALENTO API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Database Connection (MySQL 8.0+ / MariaDB 10.6+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=balento_db
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Authentication & Security
AUTH_SECRET_KEY=change_this_to_a_random_64_character_hex_string_in_production
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_COOKIE_NAME=balento_admin_session
AUTH_SECURE_COOKIE=false

# CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting (Requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_PINCODE=60
RATE_LIMIT_COUPON=30
RATE_LIMIT_GENERAL=120

# Logging
LOG_LEVEL=debug
LOG_FILE=storage/logs/app.log
